# Server only. Never use a VITE_ prefix for this key.
OPENROUTER_API_KEY=
PORT=3001
# Optional absolute or relative directory for SQLite and recordings.
DATA_DIR=.data

# Optional local model. Keep the downloaded weights outside this repository.
LOCAL_WHISPER_MODEL_PATH=
# Defaults to .venv/bin/python.
LOCAL_WHISPER_PYTHON=
# auto uses the Mac GPU when available, otherwise CUDA or CPU.
LOCAL_WHISPER_DEVICE=auto
