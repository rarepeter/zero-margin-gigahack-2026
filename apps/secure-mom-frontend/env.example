# Optional. Copy to .env.local to override. Not required: `npm run dev` = mock, `npm run dev:live` = live.
# The UI and API intentionally use different ports in development. Vite proxies
# same-origin browser requests to the API target.
# VITE_DEV_HOST=127.0.0.1
# VITE_DEV_PORT=3100
# VITE_API_MODE=live
# VITE_API_TARGET=http://127.0.0.1:8000
