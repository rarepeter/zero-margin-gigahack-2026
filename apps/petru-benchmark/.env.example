# Server only. Never use a VITE_ prefix for this key.
OPENROUTER_API_KEY=
PORT=3001
# Optional absolute or relative directory for SQLite and recordings.
DATA_DIR=.data

# Optional local model. Keep the downloaded weights outside this repository.
LOCAL_WHISPER_MODEL_PATH=
# Defaults to .venv/bin/python.
LOCAL_WHISPER_PYTHON=
# auto uses the Mac GPU when available, otherwise CUDA or CPU.
LOCAL_WHISPER_DEVICE=auto

# MoM benchmark judge. Defaults to `claude` on PATH.
CLAUDE_BIN=
# Parallel Claude CLI judge calls.
MOM_JUDGE_CONCURRENCY=3

# Local MoM models, served by llama.cpp (brew install llama.cpp). One model loads at a time.
# Defaults to `llama-server` on PATH.
LLAMA_SERVER_BIN=
# Absolute paths to the downloaded GGUF files. See docs/mom-benchmark.md#local-models.
MUSE_GLIMMER_Q4_GGUF=
MUSE_GLIMMER_Q8_GGUF=
# Context window in tokens. The longest transcript plus minutes fits in 32768.
LOCAL_LLM_CONTEXT=32768
