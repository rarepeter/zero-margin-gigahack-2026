# TODO(discovery, TD-025): confirm the public API prefix and endpoint contract.
PIPELINE_API_HOST=127.0.0.1
PIPELINE_API_PORT=8000
PIPELINE_API_PREFIX=/api/v1
# Stable loopback portal origin used for content-free review links.
PIPELINE_PORTAL_BASE_URL=http://127.0.0.1:3100
PIPELINE_JOBS_ROUTE=/jobs
PIPELINE_JOB_ROUTE=/jobs/{job_id}
PIPELINE_TRANSCRIPT_ROUTE=/jobs/{job_id}/transcript
PIPELINE_MOM_ROUTE=/jobs/{job_id}/mom
PIPELINE_REVIEW_CONTEXT_ROUTE=/jobs/{job_id}/review-context
PIPELINE_RETRY_ROUTE=/jobs/{job_id}/retry
PIPELINE_TRANSCRIPTION_RESULT_ROUTE=/integrations/audio/jobs/{job_id}/transcription
PIPELINE_MOM_RESULT_ROUTE=/integrations/text/jobs/{job_id}/mom
PIPELINE_MOM_FAILURE_ROUTE=/integrations/text/jobs/{job_id}/failure
PIPELINE_TRANSCRIPTION_FAILURE_ROUTE=/integrations/audio/jobs/{job_id}/failure
PIPELINE_HEALTH_ROUTE=/health
PIPELINE_READY_ROUTE=/ready

# TODO(discovery): choose deployment-specific storage and log locations.
PIPELINE_STORAGE_ROOT=runtime/data
PIPELINE_LOG_FILE=runtime/logs/pipeline.log

# Fixed local identity used only because authentication/SSO is outside the MVP.
PIPELINE_DEMO_SUBMITTER_USER_ID=demo-user
PIPELINE_DEMO_SUBMITTER_EMAIL=demo@medpark.test
PIPELINE_DEMO_SUBMITTER_DISPLAY_NAME="Demo User"

# Local Mailpit SMTP only. It is loopback-bound by apps/mailpit/compose.yaml;
# disable STARTTLS for the demo. The timeout bounds connection and SMTP commands.
PIPELINE_MAIL_HOST=127.0.0.1
PIPELINE_MAIL_PORT=1025
PIPELINE_MAIL_TIMEOUT_SECONDS=5.0
PIPELINE_MAIL_USE_STARTTLS=false
PIPELINE_MAIL_ALLOWED_RECIPIENT_DOMAINS=medpark.test
PIPELINE_NOTIFICATION_SENDER=secure-mom@medpark.test
# Retry only failures known to happen before SMTP submission began.
PIPELINE_NOTIFICATION_MAX_ATTEMPTS=2

# The local speech-to-text service started with `uv run asr-service`.
PIPELINE_AUDIO_SERVICE_URL=http://127.0.0.1:8101
PIPELINE_AUDIO_SERVICE_JOBS_ROUTE=/jobs
PIPELINE_AUDIO_SERVICE_TIMEOUT_SECONDS=10.0
# This API's base URL as the speech-to-text service reaches it.
PIPELINE_AUDIO_CALLBACK_BASE_URL=http://127.0.0.1:8000
# The local MoM service started with `uv run mom-llm-service`.
PIPELINE_TEXT_SERVICE_URL=http://127.0.0.1:8102
PIPELINE_TEXT_SERVICE_JOBS_ROUTE=/jobs
PIPELINE_TEXT_SERVICE_TIMEOUT_SECONDS=10.0
PIPELINE_TRANSCRIPTION_MAX_BYTES=10485760
PIPELINE_MOM_MAX_BYTES=10485760

# TODO(discovery, TD-032): tune after integration behavior is known.
PIPELINE_WORKER_INTERVAL_SECONDS=1.0

# Local speech-to-text service (`uv run asr-service`), backed by whisper.cpp.
ASR_HOST=127.0.0.1
ASR_PORT=8101
ASR_STORAGE_ROOT=runtime/asr
ASR_LOG_FILE=runtime/logs/asr.log
# Default to whisper-server, ffmpeg and ffprobe on PATH
# (brew install whisper-cpp ffmpeg).
ASR_WHISPER_SERVER_BIN=
ASR_FFMPEG_BIN=
ASR_FFPROBE_BIN=
# Absolute paths to the ggml models. Keep them outside Git; see README.
ASR_FRAPIZ_MODEL_PATH=
ASR_FALLBACK_MODEL_PATH=
ASR_THREADS=8
# Pause detection level. Raise it (e.g. -30) when a noisy room hides pauses.
ASR_SILENCE_DB=-35
# Previous audio decoded in front of each segment; repeated words are removed.
ASR_OVERLAP_SECONDS=2.0
# Moldova_Medical_Speech_Lexicon.json. strict records term matches only;
# assisted also primes FraPiz with medical hotwords.
ASR_LEXICON_PATH=
ASR_LEXICON_MODE=strict
# Local pyannote/speaker-diarization-community-1 folder; empty disables
# diarization. mps runs on the Mac GPU (14x faster than cpu).
ASR_DIARIZATION_MODEL_PATH=
ASR_DIARIZATION_DEVICE=mps

# Local MoM service (`uv run mom-llm-service`), backed by llama.cpp.
MOM_LLM_HOST=127.0.0.1
MOM_LLM_PORT=8102
MOM_LLM_STORAGE_ROOT=runtime/mom-llm
MOM_LLM_LOG_FILE=runtime/logs/mom-llm.log
# Pipeline API that receives finished drafts and failures.
MOM_LLM_CALLBACK_BASE_URL=http://127.0.0.1:8000
MOM_LLM_RESULT_ROUTE=/api/v1/integrations/text/jobs/{job_id}/mom
MOM_LLM_FAILURE_ROUTE=/api/v1/integrations/text/jobs/{job_id}/failure
# Defaults to `llama-server` on PATH (brew install llama.cpp).
MOM_LLM_LLAMA_SERVER_BIN=
# Absolute path to Muse-Glimmer-30B-KQuant-17GB-Q4_K_M.gguf. Keep it outside Git.
MOM_LLM_MODEL_PATH=
MOM_LLM_CONTEXT_TOKENS=65536
MOM_LLM_REASONING_STRENGTH=medium
MOM_LLM_REASONING_MAX_TOKENS=8192
MOM_LLM_ANSWER_MAX_TOKENS=16384
# Language of the generated MoM: ro, ru, or en.
MOM_LLM_OUTPUT_LANGUAGE=ro
