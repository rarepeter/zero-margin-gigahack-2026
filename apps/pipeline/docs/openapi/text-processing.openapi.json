{
  "openapi": "3.1.0",
  "info": {
    "title": "Text-processing ML API",
    "version": "0.0.0-discovery",
    "description": "Provisional asynchronous boundary. The adapter supplies a UTF-8 transcript.txt file and the service pushes draft MoM JSON to the pipeline callback. TODO(discovery, TD-026): confirm the final route, field name, acknowledgement, statuses, and callback contract."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "textHealth",
        "summary": "Check the provisional service boundary",
        "responses": {
          "200": {
            "description": "TODO(discovery): define the health response",
            "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}
          }
        }
      }
    },
    "/jobs": {
      "post": {
        "operationId": "submitTextJob",
        "summary": "Submit transcript.txt for MoM processing asynchronously",
        "requestBody": {
          "required": true,
          "description": "Provisional adapter contract; correlation and idempotency are sent as headers by the pipeline.",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["transcript"],
                "properties": {
                  "transcript": {
                    "type": "string",
                    "format": "binary",
                    "description": "UTF-8 transcript.txt with text/plain media type"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Provisional asynchronous acknowledgement",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["modelJobId", "status"],
                  "properties": {
                    "modelJobId": {"type": "string", "minLength": 1},
                    "status": {"type": "string", "const": "accepted"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{modelJobId}": {
      "get": {
        "operationId": "getTextJobStatus",
        "summary": "Poll provisional text-processing status",
        "parameters": [{"$ref": "#/components/parameters/ModelJobId"}],
        "responses": {
          "200": {
            "description": "TODO(discovery): define statuses and failure representation",
            "content": {"application/json": {"schema": {"type": "object", "additionalProperties": true}}}
          }
        }
      }
    },
    "/jobs/{modelJobId}/result": {
      "get": {
        "deprecated": true,
        "operationId": "getTextJobResult",
        "summary": "Discovery placeholder not used by the implemented pipeline",
        "parameters": [{"$ref": "#/components/parameters/ModelJobId"}],
        "responses": {
          "501": {
            "description": "The implemented handoff uses the pipeline draft MoM callback instead"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ModelJobId": {
        "name": "modelJobId",
        "in": "path",
        "required": true,
        "description": "TODO(discovery): define identifier constraints",
        "schema": {"type": "string"}
      }
    }
  },
  "x-contract-status": "TODO(discovery): not an implementation contract"
}
